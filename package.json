{
  "name": "wkd-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "ext:_core": "web-ext run --no-config-discovery --source-dir build --start-url http://localhost:1111/",
    "ext:chrome": "npm run ext:_core -- --target chromium",
    "ext:firefox": "npm run ext:_core -- --target firefox-desktop",
    "start": "zola -r demo-site-shopping serve",
    "test": "eslint . && stylelint static/popup.css && tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "dir-compare": "^5.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "web-ext": "^8.9.0"
  }
}