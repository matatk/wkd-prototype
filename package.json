{
  "name": "wkd-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "ext:_core": "web-ext run --no-config-discovery --source-dir build --start-url http://localhost:1111/",
    "ext:chrome": "npm run ext:_core -- --target chromium",
    "ext:firefox": "npm run ext:_core -- --target firefox-desktop",
    "start": "zola -r demo-site-shopping serve",
    "test": "eslint . && stylelint static/popup.css && tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.294",
    "@types/node": "^22.10.6",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "dir-compare": "^5.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.0",
    "stylelint": "^16.13.2",
    "stylelint-config-standard": "^37.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "web-ext": "^8.3.0"
  }
}